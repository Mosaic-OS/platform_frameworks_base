<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profile_inbox_entry_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profile_inbox_entry_box"
                style="@style/ProfileInbox.TextBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- Wrap-content width centres a one-line text while longer text fills the box start-aligned. -->
                <TextView
                    android:id="@+id/profile_inbox_entry_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_margin="16dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true" />
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_inbox_show_image"
                style="@style/ProfileInbox.ItemAction.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/profile_inbox_show_image"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_inbox_copy"
                style="@style/ProfileInbox.ItemAction.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_inbox_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_inbox_cut"
                style="@style/ProfileInbox.ItemAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/profile_inbox_cut" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_inbox_save"
                style="@style/ProfileInbox.ItemAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/profile_inbox_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_inbox_delete"
                style="@style/ProfileInbox.ItemAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/profile_inbox_delete" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
