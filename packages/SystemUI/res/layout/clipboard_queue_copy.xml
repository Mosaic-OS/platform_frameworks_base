<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clipboard_queue_copy"
        style="@style/ClipboardQueue.ItemAction.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clipboard_queue_copy" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clipboard_queue_cut"
        style="@style/ClipboardQueue.ItemAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/clipboard_queue_cut" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clipboard_queue_save"
        style="@style/ClipboardQueue.ItemAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/clipboard_queue_save" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clipboard_queue_cancel"
        style="@style/ClipboardQueue.ItemAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@android:string/cancel" />
</LinearLayout>
